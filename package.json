{
  "name": "@lumine-code/coffeestack",
  "version": "2.0.0",
  "description": "Converts JavaScript stack traces to their original CoffeeScript locations for Lumine tooling.",
  "main": "./index.js",
  "scripts": {
    "build": "coffee --compile index.coffee",
    "pretest": "npm run build",
    "test": "jasmine",
    "prepare": "npm run build"
  },
  "repository": "https://github.com/lumine-code/coffeestack",
  "bugs": "https://github.com/lumine-code/coffeestack/issues",
  "homepage": "https://github.com/lumine-code/coffeestack/",
  "keywords": [
    "CoffeeScript",
    "JavaScript",
    "stack",
    "stacktrace",
    "trace",
    "source maps"
  ],
  "author": "lumine-code",
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.js"
  ],
  "dependencies": {
    "coffeescript": "2.7.0",
    "source-map-js": "^1.2.1"
  },
  "devDependencies": {
    "jasmine": "^6.3.0"
  }
}
